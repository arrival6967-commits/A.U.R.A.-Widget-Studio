<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude local device-specific widget configs, pending drafts, and cache from cloud backup -->
    <exclude domain="sharedpref" path="aura_pending_widget_prefs.xml" />
    <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    <exclude domain="root" path="aura_widget_config_.*" />
</full-backup-content>
