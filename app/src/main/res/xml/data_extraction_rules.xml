<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- User data is synced via Firebase Firestore. Exclude transient drafts and device configs -->
        <exclude domain="sharedpref" path="aura_pending_widget_prefs.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="root" path="aura_widget_config_.*" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude transient pending draft on device migration -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="aura_pending_widget_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
